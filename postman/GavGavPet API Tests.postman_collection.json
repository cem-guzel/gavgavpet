      "name": "POST /appointments - Başarılı senaryo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code 200 dönmeli\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Dönen randevu doğru petName içermeli\", () => {\r",
              "  const body = pm.response.json();\r",
              "  pm.expect(body.petName).to.eql(\"Karabaş\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"ownerName\": \"Ahmet Yılmaz\",\r\n  \"phone\": \"+905368994374\",\r\n  \"petName\": \"Karabaş\",\r\n  \"petBreed\": \"Golden Retriever\",\r\n  \"date\": \"2026-08-20\",\r\n  \"notes\": \"İlk kez geliyoruz\"\r\n}",
